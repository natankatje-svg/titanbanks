# HTTP Basic Auth for private preview deploys.
# Set BASIC_AUTH_ENABLED=false to disable (default is ON when these are present).
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USER=titan
BASIC_AUTH_PASSWORD=change-me

# Ecwid REST API — gebruikt door scripts/ecwid-sync.ts
# Token aanmaken: my.ecwid.com → My profile → Develop apps → Create app
# Scopes: read_catalog, create_catalog, update_catalog
# Store ID: Ecwid admin → Settings → General → Store ID
ECWID_STORE_ID=
ECWID_ACCESS_TOKEN=
